# Copy to .env and change what you need. Every setting is optional.

# Ports on this machine. Students open http://<host>:HTTP_PORT/dashboard
# or https://<host>:HTTPS_PORT/dashboard.
HTTP_PORT=8081
HTTPS_PORT=8444

# Instructor key for /dashboard/admin. Leave empty to generate one on first start
# (shown in `docker compose logs netlab`).
ADMIN_KEY=

# Most lab machines running at once.
# A lab uses about 10 MB RAM idle and more while a student works in it
# (each workstation is capped at 192 MB).
MAX_LABS=30

# Every lab machine stops this many minutes after launch, so labs that students
# leave behind free their resources. In the last 15 minutes the dashboard offers
# an Extend button (another LAB_MINUTES from then) to students who are still
# working. Set LAB_EXTEND=0 to turn that off. The instructor view can always extend.
LAB_MINUTES=60
LAB_EXTEND=1

# Real HTTPS certificate from Let's Encrypt (for a server with a public IP or DNS name).
# Needs HTTP_PORT=80 and HTTPS_PORT=443, and port 80 reachable from the internet.
# An IP address gets a short-lived (about 6 day) certificate that renews by itself.
# Set ACME_STAGING=1 to test against the Let's Encrypt staging server first.
PUBLIC_HOST=
ACME_STAGING=0

# Or use your own certificate: put the files in ./certs, uncomment the ./certs volume
# line in docker-compose.yml, and set:
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem

# Set to 1 only when a reverse proxy in front of this lab sets X-Forwarded-For and
# X-Forwarded-Proto. Leave at 0 when students connect to these ports directly.
TRUST_PROXY=0
